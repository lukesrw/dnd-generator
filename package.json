{
    "name": "dnd-generator",
    "version": "1.2.0",
    "type": "module",
    "tshy": {
        "main": true,
        "exports": {
            "./package.json": "./package.json",
            ".": "./src/index.ts"
        }
    },
    "main": "./dist/commonjs/index.js",
    "types": "./dist/commonjs/index.d.ts",
    "files": [
        "dist"
    ],
    "description": "A system for generating random D&D/fantasy information",
    "author": "Luke Wilson <lukesrw@gmail.com>",
    "license": "GPL-3.0",
    "repository": "git://github.com/lukesrw/dnd-generator.git",
    "scripts": {
        "preinstall": "npm run clean",
        "clean": "rimraf -g *.tgz && rimraf -g .tshy* && rimraf coverage && rimraf html && rimraf dist",
        "build": "npm run clean && tshy && cls",
        "pretest": "npm run clean && tsc && cls",
        "test": "vitest --run --coverage",
        "posttest": "npm run clean",
        "prepack": "npm run build && npm run readme",
        "postpack": "npm run clean",
        "readme": "node dist/commonjs/script/readme"
    },
    "prettier": {
        "tabWidth": 4,
        "useTabs": false,
        "singleQuote": false,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "printWidth": 120
    },
    "devDependencies": {
        "@types/madge": "^5.0.3",
        "@types/node": "^20.14.8",
        "@vitest/coverage-istanbul": "^1.6.0",
        "madge": "^7.0.0",
        "rimraf": "^5.0.7",
        "tshy": "^1.15.1",
        "typescript": "^5.5.2",
        "vitest": "^1.6.0"
    },
    "dependencies": {
        "@dice-roller/rpg-dice-roller": "^5.1.0",
        "fantasy-name-generator": "^2.0.0"
    },
    "keywords": [
        "dnd",
        "generator",
        "rng",
        "class",
        "race"
    ],
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": {
                "source": "./src/index.ts",
                "types": "./dist/esm/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "source": "./src/index.ts",
                "types": "./dist/commonjs/index.d.ts",
                "default": "./dist/commonjs/index.js"
            }
        }
    }
}
