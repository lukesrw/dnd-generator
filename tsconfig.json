{
    "compilerOptions": {
        "incremental": true,
        "target": "ES2015",
        "module": "NodeNext",
        "moduleResolution": "Node16",
        "sourceMap": true,
        "removeComments": true,
        "declaration": true,
        "declarationMap": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleDetection": "force",
        "isolatedModules": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "lib": ["ES2015"],
        "types": ["vitest/globals"],
        "outDir": "dist"
    },
    "include": ["src", "vitest.config.ts"],
    "exclude": ["node_modules"]
}
